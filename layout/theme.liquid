<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#003da6">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.tagged_with' | t: tags: current_tags.first }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Questrial&family=Unbounded:wght@600&display=swap" rel="stylesheet">
    {%- liquid
      assign font_hh = 'HamburgHand-Bold.woff2' | file_url
      assign font_bm = 'Bermont-Black.woff2' | file_url
    -%}
    <link rel="preload" href="{{ font_hh }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ font_bm }}" as="font" type="font/woff2" crossorigin>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'theme-r3.css' | asset_url | stylesheet_tag }}
    {{ 'theme-r4.css' | asset_url | stylesheet_tag }}
    {{ 'theme-r5.css' | asset_url | stylesheet_tag }}
    {%- comment -%} Brand fonts live in Content > Files (HamburgHand-Bold.woff2, Bermont-Black.woff2). These rules come after theme.css so they win. {%- endcomment -%}
    <style>
      @font-face { font-family: 'Hamburg Hand'; src: url('{{ font_hh }}') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
      @font-face { font-family: 'BERMONT'; src: url('{{ font_bm }}') format('woff2'); font-weight: 900; font-style: normal; font-display: swap; }
      :root:root { --hh: 1; }
    </style>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.HT = {
        routes: {
          cart: '{{ routes.cart_url }}',
          cartAdd: '{{ routes.cart_add_url }}',
          cartChange: '{{ routes.cart_change_url }}',
          root: '{{ routes.root_url }}'
        },
        moneyFormat: {{ shop.money_format | json }}
      };
    </script>

    {{ content_for_header }}
    {% render 'schema-org' %}
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    <div class="overlay" data-overlay hidden></div>
  </body>
</html>
