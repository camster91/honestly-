{%- comment -%} Card backdrop colours from the Figma shop page. {%- endcomment -%}
{%- assign t = title | downcase -%}
{%- if t contains 'bundle' or t contains 'variety' -%}#fff0a4
{%- elsif t contains 'pack of' or t contains 'multipack' -%}
  {%- if t contains 'jasmine' -%}#c7cca3{%- elsif t contains 'brown' -%}#fff0a4{%- else -%}#e8a1a6{%- endif -%}
{%- elsif t contains 'jasmine' -%}#5c207d
{%- elsif t contains 'brown' -%}#9b6811
{%- elsif t contains 'white' -%}#e4dec1
{%- else -%}#eae8d3
{%- endif -%}
