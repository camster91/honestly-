{%- comment -%} Pattern band. Usage: {% render 'band', color: 'red' %} {%- endcomment -%}
<div class="band{% if color == 'red' %} band--red{% endif %}" aria-hidden="true" style="background-image: url('{{ 'ht-band.svg' | asset_url }}');">
  <img src="{{ 'ht-band.svg' | asset_url }}" alt="" width="1440" height="202" loading="lazy">
</div>

{% stylesheet %}
/* The pattern repeats across the full width, so wide screens (1980px+) have no empty ends */
.band { background-repeat: repeat-x; background-position: center top; background-size: calc(1440 * var(--u)) calc(202 * var(--u)); }
@media (max-width: 749px) {
  .band { background-size: calc(720 * var(--u)) calc(101 * var(--u)); }
}
{% endstylesheet %}
