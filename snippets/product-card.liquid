{%- comment -%} Shop-all card (Figma 5:1933). Usage: {% render 'product-card', product: product %} {%- endcomment -%}
{%- capture bg -%}{% render 'variety-color', title: product.title %}{%- endcapture -%}
{%- liquid
  assign t = product.title | downcase
  assign label = product.type | upcase
  if t contains 'bundle' or t contains 'variety'
    assign label = 'VARIETY PACK'
  elsif t contains 'pack of' or t contains 'multipack'
    assign label = 'MULTIPACKS'
  elsif t contains 'jasmine'
    assign label = 'JASMINE'
  elsif t contains 'brown'
    assign label = 'BROWN RICE'
  elsif t contains 'white'
    assign label = 'WHITE RICE'
  endif
  assign v = product.selected_or_first_available_variant
-%}
<div class="o1-pcard" style="--card: {{ bg | strip }};">
  <a class="o1-pcard__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 750px) 28vw, 90vw', alt: '' }}
    {%- endif -%}
  </a>
  {%- if product.compare_at_price > product.price and product.available -%}<span class="o1-pcard__badge">Sale</span>{%- endif -%}
  {%- unless product.available -%}<span class="o1-pcard__badge" style="background: var(--navy)">Sold out</span>{%- endunless -%}
  {%- if product.available and product.has_only_default_variant -%}
    <button type="button" class="o1-pcard__add" data-quick-add="{{ v.id }}" aria-label="Add {{ product.title | escape }} to bag">+</button>
  {%- elsif product.available -%}
    <a class="o1-pcard__add" href="{{ product.url }}" aria-label="Choose options for {{ product.title | escape }}">+</a>
  {%- endif -%}
  {%- if label != blank -%}<p class="o1-pcard__type">{{ label }}</p>{%- endif -%}
  <a class="o1-pcard__title" href="{{ product.url }}">{{ product.title }}</a>
  <p class="o1-pcard__price">
    {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
    {%- if product.price_varies -%}From {% endif -%}{{ product.price | money }}
  </p>
</div>
