{%- assign p = section.settings.product -%}
{%- assign variant = p.selected_or_first_available_variant -%}
<section class="section scheme-{{ section.settings.scheme }}" aria-labelledby="Bundle-{{ section.id }}">
  <div class="page-width bundle__grid">
    <div class="bundle__media">
      <span class="bundle__texas" aria-hidden="true" style="aspect-ratio: 584 / 556; background: currentColor; -webkit-mask: url('{{ 'ht-texas.svg' | asset_url }}') center / contain no-repeat; mask: url('{{ 'ht-texas.svg' | asset_url }}') center / contain no-repeat;"></span>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1100 | image_tag: class: 'bundle__img', loading: 'lazy', widths: '500, 800, 1100', sizes: '(min-width: 990px) 40vw, 90vw', alt: section.settings.image.alt | default: 'Honestly Texas variety pack' }}
      {%- else -%}
        <img class="bundle__img" src="{{ 'ht-packs-three.webp' | asset_url }}" alt="Honestly Texas variety pack: enriched white, brown and jasmine rice" width="1168" height="1016" loading="lazy">
      {%- endif -%}
      {%- if section.settings.caption != blank -%}<p class="bundle__caption">{{ section.settings.caption }}</p>{%- endif -%}
    </div>
    <div class="bundle__content">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="h-display h-display--sm" id="Bundle-{{ section.id }}">{{ section.settings.heading | newline_to_br }}</h2>
      {%- if section.settings.text != blank -%}<div class="body-lg">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.specs != blank -%}<p class="bundle__specs">{{ section.settings.specs }}</p>{%- endif -%}
      {%- if p != blank -%}
        <p class="bundle__price">{{ variant.price | money }}</p>
        <a class="btn btn--light" href="{{ p.url }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
      {%- if section.settings.note != blank -%}<p class="small-print" style="margin-top: 16px;">{{ section.settings.note }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product spotlight",
  "class": "section-bundle",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "select", "id": "scheme", "label": "Background", "default": "red", "options": [
      { "value": "red", "label": "Red" }, { "value": "blue", "label": "Blue" }, { "value": "navy", "label": "Navy" }, { "value": "yellow", "label": "Yellow" }
    ] },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Image caption", "default": "White + brown + jasmine" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your first taste of Honestly Texas" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "New here?\nTry all three." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>One bag of enriched white, one brown and one jasmine. Find your favorite, one meal at a time.</p>" },
    { "type": "text", "id": "specs", "label": "Specs", "default": "3 × 2 lb bags · 6 lb total" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View variety pack" },
    { "type": "text", "id": "note", "label": "Note", "default": "Shipping rates shown at checkout." }
  ],
  "presets": [{ "name": "Product spotlight" }]
}
{% endschema %}
