<section class="o1-page">
  <div class="o1-page__inner">
    <h1 class="hh o1-page__title" style="margin-bottom: 24px;">Search</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="o1-form" style="margin-bottom: 40px;">
      <div class="o1-field">
        <label for="SearchInput">Search our shop</label>
        <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Jasmine, brown rice, multipack…">
      </div>
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="pill o1-btn-blue">Search</button>
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="eyebrow">{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }} for “{{ search.terms | escape }}”</p>
        {%- if search.results_count > 0 -%}
          <ul class="o1-shop__grid" style="margin-top:40px">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <div class="article-card"><h2 class="h3"><a href="{{ item.url }}">{{ item.title }}</a></h2><p>{{ item.content | strip_html | truncatewords: 24 }}</p></div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p>No results. Try a different word, or <a href="{{ routes.all_products_collection_url }}">shop all rice</a>.</p>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search results", "class": "section-main-search" }
{% endschema %}
