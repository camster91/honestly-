{%- paginate collection.products by section.settings.per_page -%}
<section class="collection-hero">
  <div class="page-width">
    <h1 class="h-display">{{ section.settings.heading | default: collection.title }}</h1>
    {%- if collection.description != blank and section.settings.show_description -%}<div class="collection-hero__desc rte">{{ collection.description }}</div>{%- endif -%}

    {%- assign nav = linklists[section.settings.nav_menu] -%}
    <nav class="collection-nav" aria-label="Rice categories">
      {%- if nav.links.size > 0 -%}
        {%- for link in nav.links -%}<a href="{{ link.url }}"{% if link.url == collection.url or link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{%- endfor -%}
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}"{% if collection.handle == 'all' %} aria-current="page"{% endif %}>Shop all</a>
        {%- for c in collections -%}
          {%- if c.handle != 'all' and c.handle != 'frontpage' and c.products_count > 0 -%}
            <a href="{{ c.url }}"{% if c.handle == collection.handle %} aria-current="page"{% endif %}>{{ c.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </nav>

    <div class="collection-toolbar">
      <span>{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</span>
      <label>
        <span class="visually-hidden">Sort by</span>
        <select data-sort aria-label="Sort products">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>
    </div>
  </div>
</section>

<section class="section" style="padding-top: 0;">
  <div class="page-width">
    {%- if collection.products.size > 0 -%}
      <ul class="product-grid">
        {%- for product in collection.products -%}
          <li class="reveal">{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        <nav aria-label="Pagination">
          <ul class="pagination">
            {%- if paginate.previous -%}<li><a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a></li>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<li><a href="{{ part.url }}">{{ part.title }}</a></li>
              {%- elsif part.title == paginate.current_page -%}<li><span class="current" aria-current="page">{{ part.title }}</span></li>
              {%- else -%}<li><span>{{ part.title }}</span></li>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<li><a href="{{ paginate.next.url }}" aria-label="Next page">→</a></li>{%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="empty-state">
        <h2 class="h2">Nothing here yet.</h2>
        <p>Check back soon, or browse all of our rice.</p>
        <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">Shop all rice {% render 'icon', name: 'arrow' %}</a>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading override", "info": "Leave empty to use the collection title." },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "link_list", "id": "nav_menu", "label": "Category menu", "info": "Leave empty to list all collections." },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 48, "step": 3, "default": 24 }
  ]
}
{% endschema %}
