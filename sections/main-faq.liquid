<section class="o1-page">
  <div class="o1-page__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="o1-page__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="hh o1-page__title">{{ section.settings.heading }}</h1>
    <div class="o1-faq-search">
      {% render 'icon', name: 'search' %}
      <label class="visually-hidden" for="FaqSearch">Search FAQs</label>
      <input id="FaqSearch" type="search" placeholder="Search FAQs" data-faq-search="#FaqList" autocomplete="off">
    </div>
    <div class="o1-faq" id="FaqList">
      {%- for block in section.blocks -%}
        <details class="faq-item" {{ block.shopify_attributes }}{% if section.settings.open_all %} open{% endif %}>
          <summary>{{ block.settings.question }}</summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    <p class="rte" data-faq-empty hidden style="margin-top:24px">No answers match that search. <a href="/pages/contact">Ask us directly</a>.</p>
    {%- if page.content != blank -%}<div class="rte" style="margin-top: 48px;">{{ page.content }}</div>{%- endif -%}
  </div>
</section>
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {%- for block in section.blocks -%}
  { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
] }
</script>
{% schema %}
{
  "name": "FAQ",
  "class": "section-main-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Quick answers to common questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What can we help you find?" },
    { "type": "checkbox", "id": "open_all", "label": "Open all answers", "default": true }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
    ] }
  ]
}
{% endschema %}
