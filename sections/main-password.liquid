<section class="section" style="min-height: 100vh; display: flex; align-items: center;">
  <div class="o1-page__inner" style="max-width: 760px; text-align: center;">
    <img src="{{ 'ht-badge.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="200" height="115" style="margin: 0 auto 40px;">
    <h1 class="hh o1-page__title">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="body-lg" style="margin: 20px 0 32px;">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'o1-form', style: 'margin: 0 auto;' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, password page">
      {%- if form.posted_successfully? -%}
        <p class="o1-msg o1-msg--ok" role="status" style="margin: 0 auto;">Thanks! We’ll let you know when we open.</p>
      {%- else -%}
        <div class="o1-field" style="text-align: left;">
          <label for="PwEmail" style="color: var(--ht-cream);">Email address</label>
          <input id="PwEmail" type="email" name="contact[email]" autocomplete="email" placeholder="you@example.com" required>
        </div>
        <button type="submit" class="pill o1-btn-red">Notify me</button>
      {%- endif -%}
    {%- endform -%}
    <details style="margin-top: 48px;">
      <summary style="cursor: pointer; font-weight: 700;">Store owner? Enter password</summary>
      {%- form 'storefront_password', class: 'o1-form', style: 'margin: 20px auto 0;' -%}
        <div class="o1-field" style="text-align: left;">
          <label for="PwPassword" style="color: var(--ht-cream);">Password</label>
          <input id="PwPassword" type="password" name="password" autocomplete="current-password"{% if form.errors %} aria-invalid="true"{% endif %}>
        </div>
        <button type="submit" class="pill o1-btn-red">Enter</button>
        {%- if form.errors -%}<p class="o1-msg o1-msg--err" role="alert">Wrong password. Please try again.</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "class": "section-main-password",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Good rice is coming." } ]
}
{% endschema %}
