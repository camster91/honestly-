{%- paginate blog.articles by 9 -%}
<section class="o1-page">
  <div class="o1-page__inner">
    <h1 class="hh o1-page__title">{{ blog.title }}</h1>
    {%- if blog.articles.size > 0 -%}
      <ul class="blog-grid">
        {%- for article in blog.articles -%}
          <li class="article-card reveal">
            {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.image.alt | default: article.title | escape }}{%- endif -%}
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %-d, %Y' }}</time>
            <h2 class="h3"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- else -%}
      <p style="margin-top: 24px;">Stories from the farm are coming soon.</p>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "class": "section-main-blog" }
{% endschema %}
