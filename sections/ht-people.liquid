<section class="section scheme-{{ section.settings.scheme }}" aria-labelledby="People-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="color: var(--ht-red);">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="h-display h-display--sm" id="People-{{ section.id }}">{{ section.settings.heading | newline_to_br }}</h2>
    {%- if section.settings.text != blank -%}<div class="people__intro">{{ section.settings.text }}</div>{%- endif -%}
    <div class="people__grid">
      {%- for block in section.blocks -%}
        <article class="person reveal" {{ block.shopify_attributes }}>
          <div class="person__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 100vw', alt: block.settings.image.alt | default: block.settings.name | escape }}
            {%- endif -%}
          </div>
          {%- if block.settings.name != blank or block.settings.text != blank -%}
            <div class="person__body">
              {%- if block.settings.name != blank -%}<h3 class="h3">{{ block.settings.name }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "People cards",
  "class": "section-people",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "default": "wheat", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "wheat", "label": "Wheat" }, { "value": "yellow", "label": "Yellow" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The people / 01" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "From our farmers\nto your family." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every grain starts with the people who grow it. Our story is connected to Texas growers, their communities, and a shared commitment to making good rice for everyday meals.</p>" }
  ],
  "blocks": [
    { "type": "person", "name": "Person", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "text", "label": "Role or note" }
    ] }
  ],
  "presets": [{ "name": "People cards", "blocks": [{ "type": "person" }, { "type": "person" }, { "type": "person" }] }]
}
{% endschema %}
