{%- liquid
  assign menu = linklists[section.settings.menu]
-%}
<header class="site-header">
  <div class="site-header__canvas">
    <nav class="site-header__nav" aria-label="Main">
      <button type="button" class="site-header__menu-btn" data-open-menu aria-controls="MobileMenu" aria-expanded="false">Menu</button>
      {%- if menu.links.size > 0 -%}
        {%- for link in menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}"{% if request.page_type == 'collection' %} aria-current="page"{% endif %}>Our Rice</a>
        <a href="{{ section.settings.about_url | default: '/pages/about-us' }}">About</a>
        <a href="{{ section.settings.faq_url | default: '/pages/frequently-asked-questions' }}">FAQ</a>
        <a href="{{ section.settings.contact_url | default: '/pages/contact' }}">Contact</a>
      {%- endif -%}
    </nav>

    <a href="{{ routes.root_url }}" class="site-header__badge" aria-label="{{ shop.name | escape }} home">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 726 | image_tag: alt: shop.name, loading: 'eager' }}
      {%- else -%}
        <img src="{{ 'ht-badge.svg' | asset_url }}" alt="Honestly Texas: veteran, woman, family owned" width="363" height="233">
      {%- endif -%}
    </a>

    <a href="{{ routes.cart_url }}" class="site-header__cart" data-open-cart aria-controls="CartDrawer" aria-expanded="false" aria-label="Bag, {{ cart.item_count }} items">
      <span>(<span data-cart-count>{{ cart.item_count }}</span>)</span>
      <img src="{{ 'ht-cart.svg' | asset_url }}" alt="" width="33" height="33">
    </a>
  </div>
</header>

<div class="mobile-menu" id="MobileMenu" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true">
  <div class="mobile-menu__top">
    <button type="button" data-close-panel>Close</button>
    <button type="button" data-open-cart>Bag (<span data-cart-count>{{ cart.item_count }}</span>)</button>
  </div>
  <img class="mobile-menu__badge" src="{{ 'ht-badge.svg' | asset_url }}" alt="" width="363" height="233">
  <nav aria-label="Mobile">
    {%- if menu.links.size > 0 -%}
      {%- for link in menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    {%- else -%}
      <a href="{{ routes.all_products_collection_url }}">Our Rice</a>
      <a href="{{ section.settings.about_url | default: '/pages/about-us' }}">About</a>
      <a href="{{ section.settings.faq_url | default: '/pages/frequently-asked-questions' }}">FAQ</a>
      <a href="{{ section.settings.contact_url | default: '/pages/contact' }}">Contact</a>
    {%- endif -%}
  </nav>
  <div class="band mobile-menu__band"><img src="{{ 'ht-band.svg' | asset_url }}" alt="" width="1440" height="202" loading="lazy"></div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "info": "Leave empty for Our Rice, About, FAQ, Contact." },
    { "type": "image_picker", "id": "logo", "label": "Badge logo override" },
    { "type": "url", "id": "about_url", "label": "About page" },
    { "type": "url", "id": "faq_url", "label": "FAQ page" },
    { "type": "url", "id": "contact_url", "label": "Contact page" }
  ]
}
{% endschema %}
