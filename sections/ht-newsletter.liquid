<section class="section scheme-{{ section.settings.scheme }} newsletter" aria-labelledby="Newsletter-{{ section.id }}">
  <div class="page-width">
    <h2 class="h-display" id="Newsletter-{{ section.id }}">{{ section.settings.heading | newline_to_br }}</h2>
    {%- if section.settings.text != blank -%}<p class="body-sm" style="font-size: 18px;">{{ section.settings.text }}</p>{%- endif -%}
    {%- assign form_id = 'Newsletter-form-' | append: section.id -%}
    {%- form 'customer', id: form_id, class: 'newsletter__wrap' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <div class="form-message form-message--success" role="status">{{ section.settings.success }}</div>
      {%- else -%}
        <div class="newsletter__form">
          <div class="field">
            <label for="NewsletterEmail-{{ section.id }}">Email address</label>
            <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="you@example.com" required
              {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% endif %}>
          </div>
          <button type="submit" class="btn btn--primary">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</button>
        </div>
        {%- if form.errors -%}
          <div class="form-message form-message--error" id="NewsletterError-{{ section.id }}" role="alert">
            {%- if form.errors.messages['email'] contains 'taken' -%}You’re already on the list. Thanks for being here!{%- else -%}Please enter a valid email address, like you@example.com.{%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
    {%- if section.settings.consent != blank -%}<p class="newsletter__consent">{{ section.settings.consent }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Email signup",
  "class": "section-newsletter",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "default": "yellow", "options": [
      { "value": "yellow", "label": "Yellow" }, { "value": "cream", "label": "Cream" }, { "value": "wheat", "label": "Wheat" }
    ] },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Good things\nare growing." },
    { "type": "text", "id": "text", "label": "Text", "default": "Recipes, rice stories and a little news from home. Straight to your inbox." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign me up" },
    { "type": "text", "id": "success", "label": "Success message", "default": "You’re in! Watch your inbox for recipes and news from home." },
    { "type": "text", "id": "consent", "label": "Consent text", "default": "By signing up, you agree to receive emails from Honestly Texas. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Email signup" }]
}
{% endschema %}
