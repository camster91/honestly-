<section class="o1 o1-socials" aria-labelledby="Soc-{{ section.id }}">
  <div class="o1__canvas">
    <h2 class="o1-title" id="Soc-{{ section.id }}">{{ section.settings.title }}</h2>
    {%- for block in section.blocks -%}
      <a class="o1-socials__tile" href="{{ block.settings.link | default: section.settings.profile_url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 750px) 18vw, 50vw', alt: block.settings.image.alt | default: 'Honestly Texas on social media' | escape }}
        {%- else -%}
          <span class="visually-hidden">Honestly Texas on social media</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
    <a class="o1__abs o1-socials__sticker" href="{{ section.settings.profile_url }}" target="_blank" rel="noopener">
      <img src="{{ 'ht-sticker-social.svg' | asset_url }}" alt="{{ section.settings.handle | escape }}" width="294" height="327" loading="lazy" style="width:100%;height:100%">
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Social feed",
  "class": "section-o1-socials",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Recently on socials" },
    { "type": "text", "id": "handle", "label": "Handle (sticker alt text)", "default": "@HonestlyTexas" },
    { "type": "url", "id": "profile_url", "label": "Profile link" }
  ],
  "blocks": [
    { "type": "post", "name": "Post", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "url", "id": "link", "label": "Post link" }
    ] }
  ],
  "presets": [{ "name": "Social feed", "blocks": [{ "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }] }]
}
{% endschema %}
