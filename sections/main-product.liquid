{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign t = product.title | downcase
  assign variety = ''
  if t contains 'jasmine'
    assign variety = 'jasmine'
  elsif t contains 'brown'
    assign variety = 'brown'
  elsif t contains 'white'
    assign variety = 'white'
  endif
  assign is_multi = false
  if t contains 'pack of' or t contains 'multipack'
    assign is_multi = true
  endif
  assign first = current_variant.featured_media | default: product.featured_media
-%}
<section class="o1-pdp" data-product>
  <div class="o1-pdp__canvas" data-gallery>
    <nav aria-label="Breadcrumb">
      <ol class="o1-pdp__crumbs" style="list-style:none;margin:0;padding:0">
        <li><a href="{{ routes.all_products_collection_url }}">Shop all</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{{ product.title }}</li>
      </ol>
    </nav>

    <div class="o1-pdp__main" style="--card: {{ section.settings.main_color }};">
      {%- if first -%}
        <img data-gallery-main
          src="{{ first | image_url: width: 1400 }}"
          srcset="{{ first | image_url: width: 700 }} 700w, {{ first | image_url: width: 1000 }} 1000w, {{ first | image_url: width: 1400 }} 1400w"
          sizes="(min-width: 750px) 47vw, 90vw" width="{{ first.preview_image.width }}" height="{{ first.preview_image.height }}" fetchpriority="high"
          alt="{{ first.alt | default: product.title | escape }}">
      {%- endif -%}
    </div>

    {%- if product.media.size > 1 -%}
      <ul class="o1-pdp__thumbs" aria-label="Product images">
        {%- for media in product.media limit: 3 -%}
          <li>
            <button type="button" class="o1-pdp__thumb" data-gallery-thumb
              data-src="{{ media | image_url: width: 1400 }}"
              data-srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1400 }} 1400w"
              data-alt="{{ media.alt | default: product.title | escape }}"
              {% if media.aspect_ratio < 1.25 %}data-photo{% endif %}
              aria-current="{% if media.id == first.id %}true{% else %}false{% endif %}"
              aria-label="Show image {{ forloop.index }}">
              {{ media | image_url: width: 420 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="o1-pdp__info">
      <p class="o1-pdp__vendor">{{ section.settings.vendor_text | default: product.vendor }}</p>
      <h1 class="hh o1-pdp__title">{{ product.title }}</h1>
      <p class="o1-pdp__price" data-price>
        {{ current_variant.price | money }}
        {%- if current_variant.compare_at_price > current_variant.price -%}<s>{{ current_variant.compare_at_price | money }}</s>{%- endif -%}
      </p>
      {%- assign summary = product.metafields.custom.summary.value | default: section.settings.summary -%}
      {%- if summary != blank -%}<p class="o1-pdp__summary">{{ summary }}</p>{%- endif -%}
      <div class="o1-pdp__rule"></div>

      {%- form 'product', product, data-product-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- if product.has_only_default_variant -%}
          {%- if variety != blank -%}
            {%- liquid
              assign single = nil
              assign multi = nil
              for p in collections.all.products
                assign pt = p.title | downcase
                if pt contains variety and p.available
                  if pt contains 'pack of' or pt contains 'multipack'
                    if multi == nil
                      assign multi = p
                    endif
                  elsif pt contains 'bundle' or pt contains 'variety' or pt contains '25 lb' or pt contains '1 lb'
                    continue
                  else
                    if single == nil
                      assign single = p
                    endif
                  endif
                endif
              endfor
            -%}
            {%- if single and multi -%}
              <span class="o1-pdp__label">Choose your pack</span>
              <div class="o1-pdp__packs">
                <a class="o1-pdp__pack" href="{{ single.url }}"{% unless is_multi %} aria-current="true"{% endunless %}>Single bag <small>{{ single.price | money }}</small></a>
                <a class="o1-pdp__pack" href="{{ multi.url }}"{% if is_multi %} aria-current="true"{% endif %}>Multipack <small>{{ multi.price | money }}</small></a>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- else -%}
          <div data-variant-picker>
            {%- for option in product.options_with_values -%}
              <fieldset style="border:0;padding:0;margin:0 0 18px">
                <legend class="o1-pdp__label">{{ option.name }}</legend>
                <div class="o1-pdp__packs" style="flex-wrap:wrap">
                  {%- for value in option.values -%}
                    <input type="radio" id="Opt-{{ forloop.parentloop.index }}-{{ forloop.index }}" name="option-{{ forloop.parentloop.index }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                    <label class="o1-pdp__pack" for="Opt-{{ forloop.parentloop.index }}-{{ forloop.index }}">{{ value }}</label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if section.settings.note != blank -%}<p class="o1-pdp__note">{{ section.settings.note }}</p>{%- endif -%}
        <div class="o1-pdp__buy">
          <div class="o1-qty">
            <button type="button" data-qty-step="-1" aria-label="Decrease quantity">−</button>
            <label class="visually-hidden" for="Qty">Quantity</label>
            <input id="Qty" type="number" name="quantity" value="1" min="1" inputmode="numeric">
            <button type="button" data-qty-step="1" aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" class="pill o1-pdp__add" data-add-button data-label="Add to bag &nbsp;→" {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}ADD TO BAG &nbsp;→{%- else -%}SOLD OUT{%- endif -%}
          </button>
        </div>
        <p class="o1-pdp__error" data-form-error role="alert"></p>
      {%- endform -%}
      {%- if section.settings.shipping != blank -%}<p class="o1-pdp__ship">{{ section.settings.shipping }}</p>{%- endif -%}
      <ul class="o1-pdp__trust">
        {%- assign items = section.settings.trust | split: ',' -%}
        {%- for i in items -%}<li>{{ i | strip }}</li>{%- endfor -%}
      </ul>
    </div>
  </div>

  {%- if product.description != blank -%}
    <div class="o1-pdp__desc">
      <div class="o1-pdp__desc-rule"></div>
      <h2>{{ section.settings.desc_title }}</h2>
      <div class="rte">{{ product.description }}</div>
    </div>
  {%- endif -%}

  <script type="application/json" data-variants-json>
    [{%- for v in product.variants -%}{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available | json }},"price":{{ v.price | json }},"compare_at_price":{{ v.compare_at_price | default: 0 | json }},"featured_image":{% if v.featured_image %}{"src":{{ v.featured_image | image_url: width: 1400 | json }}}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
  </script>
</section>

<section class="o1 o1-dinner" aria-labelledby="Dinner-{{ section.id }}">
  <div class="o1__canvas">
    <div class="o1__abs o1-dinner__img">
      {%- if section.settings.dinner_image != blank -%}
        {{ section.settings.dinner_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.dinner_image.alt | escape }}
      {%- else -%}
        <img src="{{ 'ht-o1-curry.webp' | asset_url }}" alt="A rice dinner ready to serve" width="1400" height="1050" loading="lazy">
      {%- endif -%}
    </div>
    <h2 class="o1__abs o1-dinner__title" id="Dinner-{{ section.id }}">{{ section.settings.dinner_title }}</h2>
    <p class="o1__abs o1-dinner__text">{{ section.settings.dinner_text }}</p>
    <a class="o1__abs pill o1-dinner__btn" href="{{ section.settings.dinner_url }}" target="_blank" rel="noopener">{{ section.settings.dinner_button }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Product page",
  "class": "section-main-product",
  "settings": [
    { "type": "color", "id": "main_color", "label": "Main image backdrop", "default": "#fff0a4" },
    { "type": "text", "id": "vendor_text", "label": "Brand line", "default": "Honestly Texas Rice" },
    { "type": "text", "id": "summary", "label": "Summary (fallback)", "default": "An everyday classic, straight from our Texas farms.", "info": "Use the product metafield custom.summary for per-product text." },
    { "type": "text", "id": "note", "label": "Note under pack choice" },
    { "type": "text", "id": "shipping", "label": "Shipping note", "default": "Shipping rates calculated at checkout." },
    { "type": "text", "id": "trust", "label": "Trust line (comma separated)", "default": "Grown in Texas, Milled in Texas, Packed in Texas" },
    { "type": "text", "id": "desc_title", "label": "Description heading", "default": "Grown with care" },
    { "type": "header", "content": "What's for dinner" },
    { "type": "image_picker", "id": "dinner_image", "label": "Image" },
    { "type": "text", "id": "dinner_title", "label": "Heading", "default": "What’s for dinner?" },
    { "type": "textarea", "id": "dinner_text", "label": "Text", "default": "From simple sides to the main event, this rice is ready for whatever is on your menu." },
    { "type": "text", "id": "dinner_button", "label": "Button label", "default": "EXPLORE RECIPES  →" },
    { "type": "text", "id": "dinner_url", "label": "Button link", "default": "https://www.usarice.com/thinkrice/recipes" }
  ]
}
{% endschema %}
