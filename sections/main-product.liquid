{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign t = product.title | downcase
  assign variety = ''
  if t contains 'jasmine'
    assign variety = 'jasmine'
  elsif t contains 'brown'
    assign variety = 'brown'
  elsif t contains 'white'
    assign variety = 'white'
  endif
  assign is_multi = false
  if t contains 'pack of' or t contains 'multipack'
    assign is_multi = true
  endif
-%}
{%- capture bg -%}{% render 'variety-color', title: product.title %}{%- endcapture -%}

<section class="pdp" data-product>
  <div class="page-width">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumbs">
        <li><a href="{{ routes.all_products_collection_url }}">Shop all</a></li>
        {%- if collection -%}<li><a href="{{ collection.url }}">{{ collection.title }}</a></li>{%- endif -%}
        <li aria-current="page">{{ product.title }}</li>
      </ol>
    </nav>

    <div class="pdp__grid">
      <div class="pdp__gallery" data-gallery style="--card-bg: {{ bg | strip }};">
        {%- assign first = current_variant.featured_media | default: product.featured_media -%}
        <div class="pdp__main-media">
          {%- if first -%}
            <img data-gallery-main{% if first.aspect_ratio < 1.25 %} class="is-photo"{% endif %}
              src="{{ first | image_url: width: 1200 }}"
              srcset="{{ first | image_url: width: 600 }} 600w, {{ first | image_url: width: 900 }} 900w, {{ first | image_url: width: 1200 }} 1200w, {{ first | image_url: width: 1600 }} 1600w"
              sizes="(min-width: 990px) 55vw, 100vw" width="{{ first.preview_image.width }}" height="{{ first.preview_image.height }}" fetchpriority="high"
              alt="{{ first.alt | default: product.title | escape }}">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <ul class="pdp__thumbs" aria-label="Product images">
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' -%}
                <li>
                  <button type="button" class="pdp__thumb" data-gallery-thumb
                    data-src="{{ media | image_url: width: 1200 }}"
                    data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1200 }} 1200w"
                    data-alt="{{ media.alt | default: product.title | escape }}"
                    {% if media.aspect_ratio < 1.25 %}data-photo{% endif %}
                    aria-current="{% if media.id == first.id %}true{% else %}false{% endif %}"
                    aria-label="Show image {{ forloop.index }}">
                    {{ media | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
                  </button>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="pdp__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              <p class="pdp__vendor" {{ block.shopify_attributes }}>{{ block.settings.text | default: product.vendor }}</p>
            {%- when 'title' -%}
              <h1 class="pdp__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
            {%- when 'price' -%}
              <div {{ block.shopify_attributes }}>
                <p class="pdp__price" data-price>
                  {{ current_variant.price | money }}
                  {%- if current_variant.compare_at_price > current_variant.price -%}<s>{{ current_variant.compare_at_price | money }}</s>{%- endif -%}
                </p>
                {%- if current_variant.unit_price_measurement -%}
                  <p class="pdp__unit">{{ current_variant.unit_price | money }} / {% if current_variant.unit_price_measurement.reference_value != 1 %}{{ current_variant.unit_price_measurement.reference_value }}{% endif %}{{ current_variant.unit_price_measurement.reference_unit }}</p>
                {%- endif -%}
              </div>
            {%- when 'summary' -%}
              {%- assign summary = product.metafields.custom.summary.value | default: block.settings.text -%}
              {%- if summary != blank -%}<div class="pdp__summary" {{ block.shopify_attributes }}>{{ summary }}</div>{%- endif -%}
            {%- when 'pack_switch' -%}
              {%- if variety != blank -%}
                {%- liquid
                  assign single = nil
                  assign multi = nil
                  for p in collections.all.products
                    assign pt = p.title | downcase
                    if pt contains variety and p.available
                      if pt contains 'pack of' or pt contains 'multipack'
                        if multi == nil
                          assign multi = p
                        endif
                      elsif pt contains 'bundle' or pt contains 'variety' or pt contains '25 lb' or pt contains '1 lb'
                      else
                        if single == nil
                          assign single = p
                        endif
                      endif
                    endif
                  endfor
                -%}
                {%- if single and multi -%}
                  <div {{ block.shopify_attributes }}>
                    <span class="pdp__label">{{ block.settings.label }}</span>
                    <div class="pack-switch">
                      <a href="{{ single.url }}"{% unless is_multi %} aria-current="true"{% endunless %}>Single bag <small>{{ single.price | money }}</small></a>
                      <a href="{{ multi.url }}"{% if is_multi %} aria-current="true"{% endif %}>Multipack <small>{{ multi.price | money }}</small></a>
                    </div>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- when 'buy' -%}
              <div {{ block.shopify_attributes }}>
                {%- form 'product', product, data-product-form: '', novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  {%- unless product.has_only_default_variant -%}
                    <div data-variant-picker>
                      {%- for option in product.options_with_values -%}
                        <fieldset style="border: 0; padding: 0; margin: 0 0 20px;">
                          <legend class="pdp__label">{{ option.name }}</legend>
                          <div class="pack-switch">
                            {%- for value in option.values -%}
                              <input type="radio" id="Opt-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}" name="option-{{ forloop.parentloop.index }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                              <label for="Opt-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}">{{ value }}</label>
                            {%- endfor -%}
                          </div>
                        </fieldset>
                      {%- endfor -%}
                    </div>
                  {%- endunless -%}
                  <div class="pdp__buy">
                    <div class="qty">
                      <button type="button" data-qty-step="-1" aria-label="Decrease quantity">−</button>
                      <label class="visually-hidden" for="Qty-{{ section.id }}">Quantity</label>
                      <input id="Qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                      <button type="button" data-qty-step="1" aria-label="Increase quantity">+</button>
                    </div>
                    <button type="submit" class="btn btn--red" data-add-button data-label="{{ block.settings.label | escape }}" {% unless current_variant.available %}disabled{% endunless %}>
                      {%- if current_variant.available -%}{{ block.settings.label }}{%- else -%}Sold out{%- endif -%}
                    </button>
                  </div>
                  <p class="pdp__error" data-form-error role="alert"></p>
                  {%- if block.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
                {%- endform -%}
                {%- if block.settings.note != blank -%}<p class="pdp__note">{{ block.settings.note }}</p>{%- endif -%}
              </div>
            {%- when 'trust' -%}
              <ul class="pdp__trust" {{ block.shopify_attributes }}>
                {%- assign items = block.settings.items | split: ',' -%}
                {%- for i in items -%}<li>{{ i | strip }}</li>{%- endfor -%}
              </ul>
            {%- when 'description' -%}
              {%- if product.description != blank -%}<div class="pdp__desc rte" {{ block.shopify_attributes }}>{{ product.description }}</div>{%- endif -%}
            {%- when 'collapsible' -%}
              <div class="pdp__details" {{ block.shopify_attributes }}>
                <details>
                  <summary>{{ block.settings.heading }}</summary>
                  <div class="rte">{{ block.settings.content }}{{ block.settings.page.content }}</div>
                </details>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  <script type="application/json" data-variants-json>
    [{%- for v in product.variants -%}{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available | json }},"price":{{ v.price | json }},"compare_at_price":{{ v.compare_at_price | default: 0 | json }},"featured_image":{% if v.featured_image %}{"src":{{ v.featured_image | image_url: width: 1200 | json }}}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
  </script>
</section>

{% schema %}
{
  "name": "Product information",
  "class": "section-main-product",
  "blocks": [
    { "type": "vendor", "name": "Brand line", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Honestly Texas Rice" } ] },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "summary", "name": "Summary", "limit": 1, "settings": [
      { "type": "text", "id": "text", "label": "Fallback text", "default": "An everyday classic, straight from our Texas farms.", "info": "Use the product metafield custom.summary for per-product text." }
    ] },
    { "type": "pack_switch", "name": "Single / multipack switch", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Choose your pack" }
    ] },
    { "type": "buy", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Button label", "default": "Add to bag →" },
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": false },
      { "type": "text", "id": "note", "label": "Note", "default": "Shipping rates calculated at checkout." }
    ] },
    { "type": "trust", "name": "Trust line", "limit": 1, "settings": [
      { "type": "text", "id": "items", "label": "Items (comma separated)", "default": "Grown in Texas, Milled in Texas, Packed in Texas" }
    ] },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "collapsible", "name": "Collapsible tab", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Cooking & storage" },
      { "type": "richtext", "id": "content", "label": "Content" },
      { "type": "page", "id": "page", "label": "Content from page" }
    ] }
  ]
}
{% endschema %}
