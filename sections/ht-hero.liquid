<section class="hero scheme-{{ section.settings.scheme }}" aria-labelledby="HeroTitle-{{ section.id }}">
  <div class="page-width hero__grid">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="h-display" id="HeroTitle-{{ section.id }}">{{ section.settings.heading | newline_to_br }}</h1>
      {%- if section.settings.text != blank -%}<div class="hero__text body-lg">{{ section.settings.text }}</div>{%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="link-arrow" href="{{ section.settings.link_url | default: '/pages/about-us' }}">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="stage" style="background: {{ section.settings.stage_color }};">
      {%- if section.settings.show_texas -%}
        <img class="stage__texas" src="{{ 'ht-texas.svg' | asset_url }}" alt="" width="584" height="556" loading="eager">
      {%- endif -%}
      {%- if section.settings.packs_image != blank -%}
        {{ section.settings.packs_image | image_url: width: 1200 | image_tag: class: 'stage__packs', loading: 'eager', fetchpriority: 'high', widths: '500, 800, 1200', sizes: '(min-width: 990px) 40vw, 90vw', alt: section.settings.packs_image.alt | default: 'Honestly Texas enriched white, brown and jasmine rice bags' }}
      {%- else -%}
        <img class="stage__packs" src="{{ 'ht-packs-three.webp' | asset_url }}" alt="Honestly Texas enriched white, brown and jasmine rice bags" width="1168" height="1016" fetchpriority="high">
      {%- endif -%}
      {%- if section.settings.meal_image != blank -%}
        {{ section.settings.meal_image | image_url: width: 400 | image_tag: class: 'stage__meal', loading: 'eager', alt: section.settings.meal_image.alt | default: 'A bowl of cooked rice' }}
      {%- else -%}
        <img class="stage__meal" src="{{ 'ht-meal.webp' | asset_url }}" alt="A family serving a bowl of herbed rice" width="400" height="400">
      {%- endif -%}
      {%- if section.settings.caption != blank -%}<p class="stage__caption">{{ section.settings.caption }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "default": "cream", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "yellow", "label": "Yellow" }, { "value": "wheat", "label": "Wheat" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Good rice.\nTexas roots." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>White, brown and jasmine rice. Grown in Texas, milled in Brookshire, made for your everyday table.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Texas rice" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Secondary link label", "default": "Our Texas story" },
    { "type": "url", "id": "link_url", "label": "Secondary link" },
    { "type": "header", "content": "Product stage" },
    { "type": "color", "id": "stage_color", "label": "Stage color", "default": "#fff0a4" },
    { "type": "checkbox", "id": "show_texas", "label": "Show Texas outline", "default": true },
    { "type": "image_picker", "id": "packs_image", "label": "Packs image", "info": "Transparent PNG works best. Defaults to the three-bag render." },
    { "type": "image_picker", "id": "meal_image", "label": "Meal image (circle)" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Three varieties. Your everyday rice." }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
