<section class="o1-page">
  <div class="o1-page__inner o1-contact">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="o1-page__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="hh o1-page__title">{{ section.settings.heading | newline_to_br }}</h1>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if page.content != blank -%}<div class="rte" style="margin-top:16px">{{ page.content }}</div>{%- endif -%}
      {%- for block in section.blocks -%}
        <div class="o1-info-card rte" {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong>{{ block.settings.text }}</div>
      {%- endfor -%}
    </div>
    {%- form 'contact', class: 'o1-form', novalidate: 'novalidate' -%}
      {%- if form.posted_successfully? -%}
        <p class="o1-msg o1-msg--ok" role="status">{{ section.settings.success }}</p>
      {%- elsif form.errors -%}
        <div class="o1-msg o1-msg--err" role="alert">Please check: {% for field in form.errors %}{% if field == 'form' %}{{ form.errors.messages[field] }}{% else %}{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}{% endif %}{% unless forloop.last %}, {% endunless %}{% endfor %}</div>
      {%- endif -%}
      <div class="row">
        <div class="o1-field"><label for="CName">Name</label><input id="CName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
        <div class="o1-field"><label for="CEmail">Email *</label><input id="CEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}></div>
      </div>
      <div class="row">
        <div class="o1-field"><label for="CPhone">Phone</label><input id="CPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></div>
        <div class="o1-field"><label for="CTopic">Topic</label>
          <select id="CTopic" name="contact[topic]"><option>A question about my order</option><option>Product question</option><option>Wholesale or retail</option><option>Something else</option></select>
        </div>
      </div>
      <div class="o1-field"><label for="CBody">Message *</label><textarea id="CBody" name="contact[body]" required{% if form.errors contains 'body' %} aria-invalid="true"{% endif %}>{{ form.body }}</textarea></div>
      <div><button type="submit" class="pill o1-btn-red">{{ section.settings.button_label }}</button></div>
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Contact",
  "class": "section-main-contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Howdy.\nHow can we help?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about an order, our rice or carrying Honestly Texas in your store? Send us a note and our team will get back to you.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message  →" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thanks for reaching out! We’ll get back to you soon." }
  ],
  "blocks": [
    { "type": "card", "name": "Info card", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Wholesale & retail" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Choose “Wholesale or retail” in the form.</p>" }
    ] }
  ]
}
{% endschema %}
