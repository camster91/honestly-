<section class="find-store scheme-blue" id="find-a-store" aria-labelledby="FindStore-{{ section.id }}">
  <div class="page-width find-store__inner">
    <div>
      <h2 class="h2" id="FindStore-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--light" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <img class="find-store__mark" src="{{ 'ht-texas-mark.svg' | asset_url }}" alt="" width="160" height="153" loading="lazy">
  </div>
</section>

{% schema %}
{
  "name": "Find a store",
  "class": "section-find-store",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A little Texas, closer to home." },
    { "type": "text", "id": "text", "label": "Text", "default": "Find Honestly Texas at a store near you." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Find a store" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Find a store" }]
}
{% endschema %}
