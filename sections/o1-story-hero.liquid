<section class="o1 o1-story-hero" aria-labelledby="Story-{{ section.id }}">
  <div class="o1__canvas">
    <div class="o1-story-hero__stars o1-story-hero__stars--1" style="position:absolute;background-image:url('{{ 'ht-o1-stars.png' | asset_url }}')" aria-hidden="true"></div>
    <div class="o1-story-hero__stars o1-story-hero__stars--2" style="position:absolute;background-image:url('{{ 'ht-o1-stars.png' | asset_url }}')" aria-hidden="true"></div>
    <div class="o1__abs o1-story-hero__img">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '600, 900, 1200', sizes: '(min-width: 750px) 42vw, 90vw', alt: section.settings.image.alt | escape }}
      {%- else -%}
        <img src="{{ 'ht-grower.webp' | asset_url }}" alt="A Texas rice grower beside his combine" width="1400" height="1400">
      {%- endif -%}
    </div>
    {%- if section.settings.label != blank -%}<p class="o1__abs o1-story-hero__label">{{ section.settings.label }}</p>{%- endif -%}
    <h1 class="o1__abs hh o1-story-hero__title" id="Story-{{ section.id }}">{{ section.settings.title | newline_to_br }}</h1>
    <div class="o1__abs o1-story-hero__text">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}
      <a class="o1__abs pill o1-story-hero__btn" href="{{ section.settings.button_link | default: '/pages/contact' }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>
{% render 'band' %}

{% schema %}
{
  "name": "Story hero",
  "class": "section-o1-story-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "label", "label": "Label", "default": "01 / THE PEOPLE" },
    { "type": "textarea", "id": "title", "label": "Heading", "default": "Rooted in\nnature" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Behind every harvest is a human story.</p><p>Meet the people connected to Texas rice—and explore the mill’s next chapter through their perspective.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Story hero" }]
}
{% endschema %}
