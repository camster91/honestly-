<div class="drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" aria-hidden="true" aria-busy="false">
  <div id="CartDrawerInner" style="display: contents;">
    <div class="drawer__head">
      <h2 class="drawer__title" id="CartDrawerTitle">Your bag ({{ cart.item_count }})</h2>
      <button type="button" class="drawer__close" data-close-panel>Close</button>
    </div>
    <p class="drawer__status" id="CartDrawerStatus" role="alert"></p>
    {%- if cart.item_count > 0 -%}
      <div class="drawer__body">
        {%- for item in cart.items -%}
          <div class="cart-item" data-line="{{ forloop.index }}">
            <a class="cart-item__img" href="{{ item.url }}" tabindex="-1" aria-hidden="true">{%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}</a>
            <div>
              <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="cart-item__meta">{{ item.variant.title }}</p>{%- endunless -%}
              <p class="cart-item__meta">{{ item.final_price | money }} each</p>
            </div>
            <div class="cart-item__row">
              <div class="cart-qty">
                <button type="button" data-cart-step="-1" aria-label="Decrease quantity of {{ item.product.title | escape }}"{% if item.quantity <= 1 %} disabled{% endif %}>−</button>
                <label class="visually-hidden" for="DQ-{{ forloop.index }}">Quantity of {{ item.product.title | escape }}</label>
                <input id="DQ-{{ forloop.index }}" type="number" min="0" value="{{ item.quantity }}" inputmode="numeric" data-cart-qty>
                <button type="button" data-cart-step="1" aria-label="Increase quantity of {{ item.product.title | escape }}">+</button>
              </div>
              <button type="button" class="cart-remove" data-cart-remove>Remove<span class="visually-hidden"> {{ item.product.title | escape }}</span></button>
              <span class="total">{{ item.final_line_price | money }}</span>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="drawer__foot">
        <div class="drawer__subtotal"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
        <p>Shipping and taxes calculated at checkout.</p>
        <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="pill drawer__checkout">Checkout &nbsp;→</button></form>
        <button type="button" class="drawer__continue" data-close-panel>Continue shopping</button>
      </div>
    {%- else -%}
      <div class="drawer__body">
        <div class="drawer__empty">
          <p class="drawer__title" style="color:var(--blue)">Your bag is empty.</p>
          <p>Start with a 2 lb bag of the rice you love, or try all three.</p>
          <a class="pill o1-btn-blue" href="{{ routes.all_products_collection_url }}">Shop our rice</a>
          {%- if section.settings.bundle != blank -%}<a class="pill o1-btn-red" href="{{ section.settings.bundle.url }}">Try the variety pack</a>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Cart drawer",
  "class": "section-cart-drawer",
  "settings": [ { "type": "product", "id": "bundle", "label": "Suggested bundle (empty bag)" } ]
}
{% endschema %}
