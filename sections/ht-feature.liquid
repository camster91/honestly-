{%- comment -%} "What's for dinner?" style feature with framed image (PDP) {%- endcomment -%}
<section class="section scheme-{{ section.settings.scheme }} split split--reverse" aria-labelledby="Feature-{{ section.id }}">
  <div class="page-width split__grid">
    <div class="split__media split__media--framed reveal" style="--ratio: 5/4;">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 990px) 45vw, 100vw', alt: section.settings.image.alt | escape }}
      {%- else -%}
        <img src="{{ 'ht-meal.webp' | asset_url }}" alt="A family serving a bowl of rice" width="1400" height="788" loading="lazy">
      {%- endif -%}
    </div>
    <div class="split__content">
      <h2 class="h-display h-display--sm" id="Feature-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte body-lg" style="color: var(--ht-blue);">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--primary" href="{{ section.settings.button_link }}"{% if section.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature with frame",
  "class": "section-feature",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "default": "wheat", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "wheat", "label": "Wheat" }, { "value": "yellow", "label": "Yellow" }
    ] },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What’s for dinner?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>From simple sides to the main event, this rice is ready for whatever is on your menu.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore recipes" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "https://www.usarice.com/thinkrice/recipes" },
    { "type": "checkbox", "id": "new_tab", "label": "Open link in new tab", "default": true }
  ],
  "presets": [{ "name": "Feature with frame" }]
}
{% endschema %}
