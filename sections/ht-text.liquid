<section class="section scheme-{{ section.settings.scheme }} text-band" aria-labelledby="Text-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.rule -%}<div class="text-band--rule" style="padding-top: 48px;">{%- endif -%}
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="{% if section.settings.display %}h-display h-display--sm{% else %}h2{% endif %}" id="Text-{{ section.id }}" style="margin-bottom: 20px;">{{ section.settings.heading | newline_to_br }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte text-band__body">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--primary" style="margin-top: 28px;" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
    {%- if section.settings.rule -%}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "class": "section-text",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "default": "cream", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "yellow", "label": "Yellow" }, { "value": "wheat", "label": "Wheat" },
      { "value": "red", "label": "Red" }, { "value": "blue", "label": "Blue" }, { "value": "navy", "label": "Navy" }
    ] },
    { "type": "checkbox", "id": "rule", "label": "Top rule", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Honestly good rice." },
    { "type": "checkbox", "id": "display", "label": "Big uppercase heading", "default": false },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share a short story about your brand or product.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
