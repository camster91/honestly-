<footer class="site-footer">
  {%- if section.settings.show_band -%}{% render 'band' %}{%- endif -%}
  <div class="o1 o1-footer">
    <div class="o1__canvas">
      <img class="o1__abs o1-footer__made" src="{{ 'ht-texas-made.svg' | asset_url }}" alt="Texas Made" width="144" height="187" loading="lazy">
      <ul class="o1__abs o1-footer__links">
        {%- assign menu = linklists[section.settings.menu] -%}
        {%- if menu.links.size > 0 -%}
          {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
        {%- else -%}
          <li><a href="{{ routes.all_products_collection_url }}">Our Rice</a></li>
          <li><a href="/pages/about-us">About</a></li>
          <li><a href="/pages/frequently-asked-questions">FAQ</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        {%- endif -%}
      </ul>
      <img class="o1__abs o1-footer__seal" src="{{ 'ht-seal.svg' | asset_url }}" alt="Texas Rice Milling, Brookshire, TX" width="209" height="209" loading="lazy">
      {%- if section.settings.text_1 != blank -%}<p class="o1__abs o1-footer__copy o1-footer__copy--1">{{ section.settings.text_1 }}</p>{%- endif -%}
      <div class="o1__abs o1-footer__form">
        {%- form 'customer', id: 'FooterNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="o1-footer__field">
            <label class="visually-hidden" for="FooterEmail">Your email</label>
            <input id="FooterEmail" type="email" name="contact[email]" placeholder="Your email" autocomplete="email" required{% if form.errors %} aria-invalid="true" aria-describedby="FooterMsg"{% endif %}>
            <button type="submit" aria-label="Sign up">&gt;</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="o1-footer__msg" id="FooterMsg" role="status">{{ section.settings.success }}</p>
          {%- elsif form.errors -%}
            <p class="o1-footer__msg o1-footer__msg--error" id="FooterMsg" role="alert">Please enter a valid email address.</p>
          {%- endif -%}
        {%- endform -%}
      </div>
      {%- if section.settings.text_2 != blank -%}<p class="o1__abs o1-footer__copy o1-footer__copy--2">{{ section.settings.text_2 }}</p>{%- endif -%}
      <div class="o1__abs o1-footer__legal">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
        {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{%- endif -%}
        {%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}">Terms</a>{%- endif -%}
        {%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}">Refunds</a>{%- endif -%}
      </div>
      <img class="o1__abs o1-footer__wordmark" src="{{ 'ht-wordmark-3d.svg' | asset_url }}" alt="" width="1363" height="358" loading="lazy">
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "checkbox", "id": "show_band", "label": "Show pattern band above footer", "default": true },
    { "type": "link_list", "id": "menu", "label": "Menu" },
    { "type": "text", "id": "text_1", "label": "Text above email", "default": "Recipes, rice stories and news from home." },
    { "type": "text", "id": "text_2", "label": "Text below email", "default": "No spam. Just good rice." },
    { "type": "text", "id": "success", "label": "Signup success message", "default": "Thanks! You're on the list." }
  ]
}
{% endschema %}
