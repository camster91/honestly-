<section class="section">
  <div class="page-width">
    <h1 class="h-display h-display--sm" style="margin-bottom: 40px;">Your bag</h1>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-page__grid">
        <div>
          {%- for item in cart.items -%}
            <div class="cart-item" style="grid-template-columns: 120px 1fr;">
              <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">{%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: alt: '', loading: 'lazy', style: 'width:120px;height:90px;object-fit:contain' }}{%- endif -%}</a>
              <div>
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="cart-item__meta">{{ item.variant.title }}</p>{%- endunless -%}
                <p class="cart-item__meta">{{ item.final_price | money }} each</p>
              </div>
              <div class="cart-item__row">
                <div class="field" style="flex: none; width: 120px;">
                  <label for="Updates-{{ forloop.index }}">Quantity</label>
                  <input id="Updates-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                </div>
                <a class="cart-remove" href="{{ item.url_to_remove }}">Remove</a>
                <span class="total">{{ item.final_line_price | money }}</span>
              </div>
            </div>
          {%- endfor -%}
          <button type="submit" name="update" class="btn btn--outline" style="margin-top: 24px;">Update bag</button>
        </div>
        <aside class="cart-page__summary" aria-label="Order summary">
          <div class="drawer__subtotal"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
          <p class="pdp__note" style="margin-top: 12px;">Shipping and taxes calculated at checkout.</p>
          {%- if section.settings.show_note -%}
            <div class="field cart-page__note" style="margin-top: 16px;">
              <label for="CartNote">Order note</label>
              <textarea id="CartNote" name="note">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
          <button type="submit" name="checkout" class="btn btn--primary">Checkout {% render 'icon', name: 'arrow' %}</button>
          {%- if additional_checkout_buttons -%}<div style="margin-top: 12px;">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
        </aside>
      </form>
    {%- else -%}
      <div class="empty-state" style="text-align: left; padding-top: 0;">
        <p class="body-lg" style="margin-bottom: 24px;">Your bag is empty. Start with a 2 lb bag of the rice you love.</p>
        <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">Shop all rice {% render 'icon', name: 'arrow' %}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "class": "section-main-cart",
  "settings": [ { "type": "checkbox", "id": "show_note", "label": "Enable order note", "default": false } ]
}
{% endschema %}
