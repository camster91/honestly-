{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Your {{ gift_card.balance | money }} gift card – {{ shop.name }}</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body>
  <main class="o1-page"><div class="o1-page__inner" style="max-width: 640px; text-align: center;">
    <img src="{{ 'ht-badge.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="160" height="92" style="margin: 0 auto 24px; background: var(--ht-blue); padding: 16px; border-radius: 12px;">
    <h1 class="hh o1-page__title">Your gift card</h1>
    <p class="body-lg" style="margin: 16px 0;">{{ gift_card.balance | money }}{% if gift_card.enabled == false or gift_card.expired %} · Expired or disabled{% endif %}</p>
    <p style="font-family: monospace; font-size: 22px; letter-spacing: .1em;">{{ gift_card.code | format_code }}</p>
    <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}" style="display: inline-block; margin: 16px 0;"></div>
    <p><a class="pill o1-btn-blue" href="{{ shop.url }}">Shop now</a></p>
    {%- if gift_card.pass_url -%}<p style="margin-top: 16px;"><a href="{{ gift_card.pass_url }}">Add to Apple Wallet</a></p>{%- endif -%}
  </div></main>
  <script>window.addEventListener('load',function(){var el=document.getElementById('QrCode');if(window.QRCode)new QRCode(el,{text:el.dataset.identifier,width:120,height:120});});</script>
</body>
</html>
